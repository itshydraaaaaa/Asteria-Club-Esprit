# Asteria Club Esprit — Environment Configuration Template

# 1. Supabase Cloud API & Auth
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_publishable_key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
SUPABASE_SECRET_KEY="your_supabase_service_role_key"

# 2. Database Connection Strings
# Supabase Transaction Pooler (port 6543) for Next.js queries:
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Supabase Session Direct connection (port 5432) for Prisma migrations:
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# 3. Session & Security Secrets
JWT_SECRET="asteria-super-secret-jwt-key-2026"

# 4. Feature Flags
NEXT_PUBLIC_DEMO_MODE="false"

# 5. Email Service & Delivery (Configured for either Resend API or direct SMTP)
# Option A: Resend API (Recommended - get key from https://resend.com)
RESEND_API_KEY=""

# Option B: Direct SMTP (e.g. Gmail App Password, Outlook, ESPRIT Mail)
# For Gmail: Use App Password from https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""

EMAIL_FROM="Asteria Club Esprit <onboarding@asteria.tn>"
NEXT_PUBLIC_APP_URL="https://asteria-club-esprit.vercel.app"
