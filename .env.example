# Asteria Club Esprit — Environment Configuration Template

# 1. Supabase Cloud API & Auth (Required)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_publishable_or_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret_key"

# 2. Application Domain (Required for email redirect links & production canonical URLs)
NEXT_PUBLIC_APP_URL="https://asteria-club-esprit.vercel.app"

# 3. Feature Flags
NEXT_PUBLIC_DEMO_MODE="false"

# 4. Email Service & Delivery (Configured for either Resend API or direct SMTP)
# Option A: Resend API (Recommended - get key from https://resend.com)
RESEND_API_KEY=""

# Option B: Direct SMTP (e.g. Gmail App Password, Outlook, ESPRIT Mail)
# For Gmail: Use App Password from https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""

EMAIL_FROM="Asteria Club Esprit <onboarding@asteria.tn>"
